<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android" >

    <CheckBoxPreference
        android:defaultValue="true"
        android:key="audible"
        android:title="@string/audible" />
    <CheckBoxPreference
        android:defaultValue="true"
        android:key="vibrate"
        android:title="@string/vibrate" />

    <PreferenceScreen
        android:key="day"
        android:title="Day" >
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_MIDDAY"
            android:summary=""
            android:title="@string/midday" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_MIDNIGHT"
            android:summary=""
            android:title="@string/midnight" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_SUNRISE"
            android:summary=""
            android:title="@string/sunrise" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_SUNSET"
            android:summary=""
            android:title="@string/sunset" />
    </PreferenceScreen>
    <PreferenceScreen
        android:key="moon"
        android:title="Moon" >
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_FULLMOON"
            android:summary=""
            android:title="@string/fullmoon" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_NEWMOON"
            android:summary=""
            android:title="@string/newmoon" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_FIRSTQUARTER"
            android:summary=""
            android:title="@string/firstquarter" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_LASTQUARTER"
            android:summary=""
            android:title="@string/lastquarter" />
    </PreferenceScreen>
    <PreferenceScreen
        android:key="year"
        android:title="Year" >
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_NORTHERNSOLSTICE"
            android:summary=""
            android:title="@string/northernsolstice" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_SOUTHERNSOLSTICE"
            android:summary=""
            android:title="@string/southernsolstice" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_NORTHWARDEQUINOX"
            android:summary=""
            android:title="@string/northwardequinox" />
        <CheckBoxPreference
            android:defaultValue="false"
            android:key="ASTROCLOCK_SOUTHWARDEQUINOX"
            android:summary=""
            android:title="@string/southwardequinox" />
    </PreferenceScreen>

</PreferenceScreen>