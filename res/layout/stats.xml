<?xml version="1.0" encoding="utf-8"?>

<ScrollView
	xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="fill_parent"
	android:layout_height="fill_parent"
	android:foregroundGravity="fill"
	android:layout_gravity="fill"
>

	<LinearLayout
		android:layout_height="fill_parent"
		android:orientation="vertical"
		android:layout_width="fill_parent"
		android:layout_gravity="fill"
		android:gravity="fill"
		android:layout_margin="5sp"
	>
		<TextView
			android:text="@string/rotation"
			android:layout_height="wrap_content"
			android:textStyle="bold"
			android:layout_width="fill_parent"
			android:layout_gravity="center"
			android:gravity="center"
			android:layout_marginTop="15sp"
		></TextView>
		<RadioGroup
			android:id="@+id/rotation"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:orientation="horizontal"
			android:layout_gravity="center"
			android:gravity="center"
		>
			<RadioButton
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/pointers"
				android:text="@string/pointers"
			></RadioButton>
			<RadioButton
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:id="@+id/rings"
				android:text="@string/rings"
			></RadioButton>
		</RadioGroup>

		<TextView
			android:layout_height="wrap_content"
			android:text="@string/day"
			android:gravity="center"
			android:layout_width="fill_parent"
			android:textStyle="bold"
			android:layout_marginTop="15sp"
		>
		</TextView>
		<RelativeLayout
			android:layout_height="wrap_content"
			android:layout_width="fill_parent"
			android:layout_marginTop="5sp"
			android:layout_marginLeft="10sp"
			android:layout_marginRight="10sp"
		>
			<TextView
				android:id="@+id/midday"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/midday"
			>
			</TextView>
			<TextView
				android:id="@+id/midnight"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/midnight"
				android:layout_alignParentRight="true"
			>
			</TextView>
		</RelativeLayout>
		<RelativeLayout
			android:layout_height="wrap_content"
			android:layout_width="fill_parent"
			android:layout_marginTop="5sp"
			android:layout_marginLeft="10sp"
			android:layout_marginRight="10sp"
		>
			<TextView
				android:layout_height="wrap_content"
				android:id="@+id/daylength"
				android:text="@string/daylength" android:layout_width="wrap_content">
			</TextView>
			<TextView
				android:layout_height="wrap_content"
				android:layout_alignParentRight="true"
				android:text="@string/nightlength"
				android:id="@+id/nightlength"
				android:layout_toRightOf="@id/daylength"
				android:gravity="right"
			android:layout_width="fill_parent">
			</TextView>
		</RelativeLayout>
		<TextView
			android:text="@string/twilight"
			android:layout_width="fill_parent"
			android:layout_height="wrap_content"
			android:gravity="center"
			android:textStyle="bold"
			android:layout_marginTop="15sp"
		></TextView>
		<RelativeLayout
			android:layout_height="wrap_content"
			android:layout_width="fill_parent"
			android:layout_marginTop="5sp"
			android:layout_marginLeft="10sp"
			android:layout_marginRight="10sp"
		>
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/sunrise"
				android:textStyle="bold"
			>
			</TextView>
			<TextView
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/sunset"
				android:layout_alignParentRight="true"
				android:textStyle="bold"
			>
			</TextView>
		</RelativeLayout>
		<TableLayout
			android:layout_height="wrap_content"
			android:layout_width="fill_parent"
			android:layout_marginRight="10sp"
			android:layout_marginLeft="10sp"
		>
			<TableRow
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
			>
				<RelativeLayout
					android:layout_width="wrap_content"
					android:layout_height="fill_parent"
					android:layout_gravity="left|center_vertical"
					android:layout_marginBottom="15sp"
					android:layout_marginTop="15sp"
				>
					<TextView
						android:layout_width="wrap_content"
						android:id="@+id/sunriseastro"
						android:layout_height="wrap_content"
					></TextView>
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_centerVertical="true"
						android:id="@+id/sunrisenautic"
					></TextView>
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentBottom="true"
						android:id="@+id/sunrisecivil"
					></TextView>
				</RelativeLayout>
				<LinearLayout
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_weight="1"
					android:gravity="center"
				>
					<RadioGroup
						android:id="@+id/twilightmode"
						android:layout_height="wrap_content"
						android:layout_width="wrap_content"
						android:layout_weight="0"
					>
						<RadioButton
							android:id="@+id/rbastro"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/astronomical"
						></RadioButton>
						<RadioButton
							android:id="@+id/rbnautic"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/nautical"
						></RadioButton>
						<RadioButton
							android:id="@+id/rbcivil"
							android:layout_width="wrap_content"
							android:layout_height="wrap_content"
							android:text="@string/civil"
						></RadioButton>
					</RadioGroup>
				</LinearLayout>
				<RelativeLayout
					android:layout_height="fill_parent"
					android:layout_width="wrap_content"
					android:layout_gravity="right|center_vertical"
					android:layout_marginTop="15sp"
					android:layout_marginBottom="15sp"
				>
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:id="@+id/sunsetastro"
					></TextView>
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_centerVertical="true"
						android:id="@+id/sunsetnautic"
					></TextView>
					<TextView
						android:layout_width="wrap_content"
						android:layout_height="wrap_content"
						android:layout_alignParentBottom="true"
						android:id="@+id/sunsetcivil"
					></TextView>
				</RelativeLayout>
			</TableRow>
		</TableLayout>
		<TextView
			android:layout_height="wrap_content"
			android:text="@string/fullmoon"
			android:gravity="center"
			android:layout_width="fill_parent"
			android:textStyle="bold"
			android:layout_marginTop="15sp"
		>
		</TextView>
		<RelativeLayout
			android:layout_height="wrap_content"
			android:layout_width="fill_parent"
			android:layout_marginTop="5sp"
			android:layout_marginLeft="10sp"
			android:layout_marginRight="10sp"
		>
			<TextView
				android:id="@+id/nextmoon"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/next"
			>
			</TextView>
			<TextView
				android:id="@+id/nextmoondays"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/days"
				android:layout_alignParentRight="true"
			>
			</TextView>
		</RelativeLayout>
		<RelativeLayout
			android:layout_height="wrap_content"
			android:layout_width="fill_parent"
			android:layout_marginTop="5sp"
			android:layout_marginLeft="10sp"
			android:layout_marginRight="10sp"
		>
			<TextView
				android:id="@+id/lastmoon"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/last"
			>
			</TextView>
			<TextView
				android:id="@+id/lastmoondays"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:text="@string/days"
				android:layout_alignParentRight="true"
			>
			</TextView>
		</RelativeLayout>
		<TextView
			android:layout_height="wrap_content"
			android:text="@string/midsummer"
			android:gravity="center"
			android:layout_width="fill_parent"
			android:textStyle="bold"
			android:layout_marginTop="15sp"
		>
		</TextView>

		<RelativeLayout
			android:layout_height="wrap_content"
			android:layout_width="fill_parent"
			android:layout_marginLeft="10sp"
			android:layout_marginRight="10sp"
			android:layout_marginBottom="15sp"
		>
			<LinearLayout
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_width="wrap_content"
			>
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/next"
					android:textStyle="bold"
					android:layout_marginTop="5sp"
				>
				</TextView>
				<TextView
					android:id="@+id/nextsummerdays"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/days"
					android:layout_marginTop="5sp"
				>
				</TextView>
				<TextView
					android:id="@+id/nextsummermoons"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/moons"
					android:layout_marginTop="5sp"
				>
				</TextView>
			</LinearLayout>
			<LinearLayout
				android:layout_height="wrap_content"
				android:orientation="vertical"
				android:layout_alignParentRight="true"
				android:layout_width="wrap_content"
			>
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/last"
					android:layout_gravity="right"
					android:textStyle="bold"
					android:layout_marginTop="5sp"
				>
				</TextView>
				<TextView
					android:id="@+id/lastsummerdays"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/days"
					android:layout_gravity="right"
					android:layout_marginTop="5sp"
				>
				</TextView>
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="@string/moons"
					android:layout_gravity="right"
					android:id="@+id/lastsummermoons"
					android:layout_marginTop="5sp"
				>
				</TextView>
			</LinearLayout>
		</RelativeLayout>
		<Button
			android:layout_height="wrap_content"
			android:id="@+id/Button"
			android:text="@string/moreapps"
			android:layout_width="fill_parent"
			android:layout_marginLeft="10sp"
			android:layout_marginRight="10sp"
			android:layout_marginBottom="5sp"
		></Button>

	</LinearLayout>
</ScrollView>
