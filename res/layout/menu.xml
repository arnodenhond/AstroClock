<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content" android:onClick="startMap">

        <ImageView
            android:id="@+id/mapmode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_menu_mapmode" android:paddingLeft="60px" android:paddingTop="40px"/>

        <ImageView
            android:id="@+id/help"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_menu_help" android:layout_alignParentRight="true" android:paddingRight="60px" android:paddingTop="40px" android:onClick="startHelp"/>

        <ImageView
            android:id="@+id/size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_menu_sort_by_size" android:layout_alignParentBottom="true" android:paddingLeft="60px" android:paddingBottom="40px" android:onClick="startStats"/>

        <ImageView
            android:id="@+id/view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_menu_view" android:layout_alignParentBottom="true" android:layout_alignParentRight="true" android:paddingRight="60px" android:paddingBottom="40px" android:onClick="startTheme"/>

</RelativeLayout>