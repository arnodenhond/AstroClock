<?xml version="1.0"	encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="arnodenhond.astroclocklite"
    android:versionCode="229"
    android:versionName="3.0 BETA 2" >

    <uses-sdk
        android:minSdkVersion="4"
        android:targetSdkVersion="15" />

    <!-- required for acquiring location -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        required="false" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        required="false" />
    <!-- required for downloading themes and ads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <!-- required for setting alerts -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- required for alerts -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.live_wallpaper"
        android:required="false" />

    <application
        android:icon="@drawable/icon"
        android:label="@string/app_name" >
        <uses-library android:name="com.google.android.maps" />

        <!-- Launchable Clock Activity -->
        <activity
            android:name="arnodenhond.astroclock.AstroClock"
            android:clearTaskOnLaunch="true"
            android:taskAffinity="arnodenhond.astroclock.AstroClock"
            android:theme="@style/AstroClockTheme" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="arnodenhond.astroclock.About" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.INFO" />
            </intent-filter>
        </activity>
        <activity
            android:name="arnodenhond.astroclock.settings.Menu"
            android:exported="true" />
        <activity android:name="arnodenhond.astroclock.settings.location.Map" />
        <activity
            android:name="arnodenhond.astroclock.settings.themes.Theme"
            android:configChanges="orientation|screenSize|keyboardHidden" />
        <activity android:name="arnodenhond.astroclock.settings.alerts.Alerts" />

        <!-- advertising -->
        <activity
            android:name="com.google.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize" />
        <activity
            android:name="com.tapjoy.TJCOffersWebView"
            android:configChanges="keyboardHidden|orientation" />
        <activity
            android:name="com.tapjoy.TapjoyFeaturedAppWebView"
            android:configChanges="keyboardHidden|orientation" />
        <activity
            android:name="com.tapjoy.TapjoyVideoView"
            android:configChanges="keyboardHidden|orientation" />
        <!-- analytics -->
        <receiver
            android:name="com.google.android.apps.analytics.AnalyticsReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER" />
            </intent-filter>
        </receiver>
        <!-- launches a broadcast and a notification if enabled. called when event expires in alarm manager -->
        <receiver
            android:name="arnodenhond.astroclock.alerts.AlarmReceiver"
            android:exported="false" >
            <intent-filter>
                <action android:name="ASTROCLOCK_MIDDAY" />
                <action android:name="ASTROCLOCK_MIDNIGHT" />
                <action android:name="ASTROCLOCK_SUNRISE" />
                <action android:name="ASTROCLOCK_SUNSET" />
                <action android:name="ASTROCLOCK_FULLMOON" />
                <action android:name="ASTROCLOCK_NEWMOON" />
                <action android:name="ASTROCLOCK_FIRSTQUARTER" />
                <action android:name="ASTROCLOCK_LASTQUARTER" />
                <action android:name="ASTROCLOCK_NORTHERNSOLSTICE" />
                <action android:name="ASTROCLOCK_SOUTHERNSOLSTICE" />
                <action android:name="ASTROCLOCK_NORTHWARDEQUINOX" />
                <action android:name="ASTROCLOCK_SOUTHWARDEQUINOX" />
            </intent-filter>
        </receiver>
        <!-- sets the upcoming events in the alarm manager. called when device boots up -->
        <receiver android:name="arnodenhond.astroclock.alerts.BootReceiver" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- appwidget -->
        <receiver
            android:name="arnodenhond.astroclock.widget.ACAppWidgetProvider"
            android:icon="@drawable/icon" >
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/appwidget_provider" />

            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
        </receiver>
        <!-- live wallpaper -->
        <service
            android:name="arnodenhond.astroclock.livewallpaper.ACWallpaperService"
            android:permission="android.permission.BIND_WALLPAPER" >
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>

            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/wallpaper" >
            </meta-data>
        </service>
    </application>

</manifest>