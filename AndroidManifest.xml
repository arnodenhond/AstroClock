<?xml version="1.0"	encoding="utf-8"?>
<manifest
	xmlns:android="http://schemas.android.com/apk/res/android"
	package="arnodenhond.astroclocklite" android:versionCode="300" android:versionName="3.0.0">
	<uses-sdk
		android:minSdkVersion="3" />
	<application
		android:icon="@drawable/icon"
		android:label="@string/app_name"
		android:theme="@android:style/Theme.Dialog"
	>
		<receiver
			android:label="@string/app_name"
			android:icon="@drawable/icon"
			android:name=".AstroClockAppWidgetProvider"
		>
			<meta-data
				android:name="android.appwidget.provider"
				android:resource="@xml/meta_appwidget_provider" />
			<intent-filter>
				<action
					android:name="android.appwidget.action.APPWIDGET_UPDATE" />
			</intent-filter>
		</receiver>
		<activity
			android:name="AstroClockActivity"
			android:label="@string/app_name"
		>
			<intent-filter>
				<action
					android:name="android.intent.action.MAIN" />
				<category
					android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>
		<activity
			android:name=".Stats"
		>
			<intent-filter>
				<action
					android:name="AstroClockWidgetStats" />
				<category
					android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>

		<activity
			android:name=".AstroClockActivity"
		>
			<intent-filter>
				<action
					android:name="AstroClockWidgetClock" />
				<category
					android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>
		<activity
			android:name=".Welcome"
		>
			<intent-filter>
				<action
					android:name="AstroClockWidgetWelcome" />
				<category
					android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>
	</application>
	<uses-permission
		android:name="android.permission.ACCESS_COARSE_LOCATION" />
	<uses-permission
		android:name="android.permission.ACCESS_FINE_LOCATION" />
</manifest> 